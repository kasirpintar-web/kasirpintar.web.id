rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user matches the document ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile documents (users/{uid})
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Store profile documents (stores/{storeId})
    match /stores/{storeId} {
      allow create: if isAuthenticated();
      allow read, update: if isAuthenticated();
      allow delete: if false; // Prevent accidental store deletion

      // Support subcollections if used
      match /categories/{categoryId} {
        allow read, write: if isAuthenticated();
      }

      match /products/{productId} {
        allow read, write: if isAuthenticated();
      }

      match /transactions/{transactionId} {
        allow read, create, update: if isAuthenticated();
        allow delete: if false;
      }
    }

    // Root-level categories collection (queried by storeId)
    match /categories/{categoryId} {
      allow read, write: if isAuthenticated();
    }

    // Root-level products collection (queried by storeId)
    match /products/{productId} {
      allow read, write: if isAuthenticated();
    }

    // Root-level transactions collection (queried by storeId)
    match /transactions/{transactionId} {
      allow read, create: if isAuthenticated();
      allow update: if isAuthenticated(); // For status cancellation
      allow delete: if false; // Transaction records must never be deleted
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

